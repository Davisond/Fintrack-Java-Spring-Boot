@host = http://localhost:8081

### Listar todos (200)
GET {{host}}/api/v1/lancamentos


### Buscar por id (troque pelo id de um item da lista)
GET {{host}}/api/v1/lancamentos/b8eff261-1405-4506-932c-f56fa1f119f9


### Buscar id inexistente (404)
GET {{host}}/api/v1/lancamentos/00000000-0000-0000-0000-000000000000


### Criar (201 + header Location)
POST {{host}}/api/v1/lancamentos
Content-Type: application/json

{
  "descricao": "Teste_banco_on",
  "valor": 150.90,
  "data": "2026-10-01",
  "tipo": "DESPESA"
}


### Valor com 3 casas (400)
POST {{host}}/api/v1/lancamentos
Content-Type: application/json

{
  "descricao": "Teste",
  "valor": 10.999,
  "data": "2026-10-01",
  "tipo": "DESPESA"
}


### Criar inválido, valor zero (400)
POST {{host}}/api/v1/lancamentos
Content-Type: application/json

{
  "descricao": "Teste",
  "valor": 0,
  "data": "2026-10-01",
  "tipo": "DESPESA"
}


### Substituir (troque pelo id)
PUT {{host}}/api/v1/lancamentos/ebd80c07-118e-4c00-af69-f652bcd87a17
Content-Type: application/json

{
  "descricao": "Mercado do mês",
  "valor": 320.00,
  "data": "2026-10-02",
  "tipo": "DESPESA"
}

### Remover (204)
DELETE {{host}}/api/v1/lancamentos/9218353b-b565-48dc-b483-86d3f63dd372

# ------------------------------------ C A T E G O R I A --------------------------------------------------


### Criar categoria (201 + Location)
POST {{host}}/api/v1/categorias
Content-Type: application/json

{
  "nome": "Mercado",
  "cor": "#FF8800"
}

### Listar categorias (200)
GET {{host}}/api/v1/categorias


### Buscar (troque pelo id)
GET {{host}}/api/v1/categorias/6096e1c0-c63c-4d1b-ac80-5888dd714b45


### Cor inválida (400, com o campo cor na lista erros)
POST {{host}}/api/v1/categorias
Content-Type: application/json

{
  "nome": "Teste",
  "cor": "vermelho"
}


### Substituir (troque pelo id)
PUT {{host}}/api/v1/categorias/6096e1c0-c63c-4d1b-ac80-5888dd714b45
Content-Type: application/json

{
  "nome": "Supermercado",
  "cor": "#00AA55"
}


### Remover (204)
DELETE {{host}}/api/v1/categorias/6096e1c0-c63c-4d1b-ac80-5888dd714b45


### Categoria inexistente (404 no formato padrão)
GET {{host}}/api/v1/categorias/00000000-0000-0000-0000-000000000000